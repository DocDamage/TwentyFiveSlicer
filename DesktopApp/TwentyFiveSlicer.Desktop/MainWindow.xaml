<Window x:Class="TwentyFiveSlicer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TwentyFiveSlicer.Desktop.Controls"
        xmlns:services="clr-namespace:TwentyFiveSlicer.Desktop.Services"
        mc:Ignorable="d"
        Title="Twenty Five Slicer Desktop"
        Height="900"
        Width="1440"
        MinHeight="760"
        MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#D9152026" />
        <SolidColorBrush x:Key="CardBrush" Color="#A61B272E" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#50344B52" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3CC7BA" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF6EFE2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA0B8B5" />
        <services:CloudAiProviderIconPathConverter x:Key="ProviderIconPathConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,18,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0E161B" Offset="0" />
                <GradientStop Color="#FF182229" Offset="0.55" />
                <GradientStop Color="#FF0A1216" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="18"
                Style="{StaticResource CardStyle}"
                Background="{StaticResource PanelBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Twenty Five Slicer"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Standalone desktop preview and border authoring for the original Unity slicing math."
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               TextWrapping="Wrap" />

                    <WrapPanel Margin="0,18,0,12">
                        <Button Style="{StaticResource ActionButtonStyle}" Click="OpenImage_Click" ToolTip="Open image">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/photo-plus.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Open Image" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="LoadPreset_Click" ToolTip="Load JSON">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/file-import.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Load JSON" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="SavePreset_Click" ToolTip="Save JSON">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/device-floppy.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Save JSON" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="CopyPreset_Click" ToolTip="Copy JSON">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/copy.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Copy JSON" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="ExportPreview_Click" ToolTip="Export PNG">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/download.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Export PNG" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="ResetBorders_Click" ToolTip="Reset borders">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/refresh.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Reset Borders" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="Undo_Click" ToolTip="Undo">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/arrow-back-up.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Undo" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButtonStyle}" Click="Redo_Click" ToolTip="Redo">
                            <StackPanel Orientation="Horizontal">
                                <controls:SvgIcon Source="Assets/Icons/Tabler/arrow-forward-up.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Redo" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}"
                                Background="{StaticResource CardBrush}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Source"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ImagePathText"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="No image loaded"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ImageSizeText"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Open a PNG, JPG, BMP, or GIF to begin." />
                                <ComboBox x:Name="RecentFilesComboBox"
                                          Margin="0,12,0,0"
                                          SelectionChanged="RecentFilesComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Background="{StaticResource CardBrush}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Preview Output"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="The preview uses the same fixed and stretchable column layout as the Unity runtime." />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Source Size"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Tag="Source"
                                            Click="PreviewSizePreset_Click" />
                                    <Button Content="512 x 512"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Tag="512x512"
                                            Click="PreviewSizePreset_Click" />
                                    <Button Content="1024 x 512"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Tag="1024x512"
                                            Click="PreviewSizePreset_Click" />
                                    <Button Content="1920 x 1080"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Tag="1920x1080"
                                            Click="PreviewSizePreset_Click" />
                                </WrapPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                        <TextBlock Text="Width" Style="{StaticResource LabelStyle}" />
                                        <Slider x:Name="TargetWidthSlider"
                                                Minimum="32"
                                                Maximum="2048"
                                                Value="640"
                                                TickFrequency="32"
                                                Foreground="{StaticResource AccentBrush}"
                                                ValueChanged="PreviewSettingChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="TargetWidthValueText"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource ValueStyle}"
                                               Text="640 px" />

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Height" Style="{StaticResource LabelStyle}" />
                                        <Slider x:Name="TargetHeightSlider"
                                                Minimum="32"
                                                Maximum="2048"
                                                Value="360"
                                                TickFrequency="32"
                                                Foreground="{StaticResource AccentBrush}"
                                                ValueChanged="PreviewSettingChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="TargetHeightValueText"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource ValueStyle}"
                                               Text="360 px" />

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,12,0">
                                        <TextBlock Text="Zoom" Style="{StaticResource LabelStyle}" />
                                        <Slider x:Name="PreviewZoomSlider"
                                                Minimum="0.5"
                                                Maximum="2"
                                                Value="1"
                                                TickFrequency="0.1"
                                                Foreground="{StaticResource AccentBrush}"
                                                ValueChanged="PreviewSettingChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewZoomValueText"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Style="{StaticResource ValueStyle}"
                                               Text="100%" />
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Zoom Out"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ZoomOut_Click" />
                                    <Button Content="100%"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ResetZoom_Click" />
                                    <Button Content="Zoom In"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ZoomIn_Click" />
                                </WrapPanel>

                                <WrapPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="KeepAspectCheckBox"
                                              Content="Lock aspect"
                                              Style="{StaticResource ToggleStyle}"
                                              Checked="KeepAspectChanged"
                                              Unchecked="KeepAspectChanged" />
                                    <CheckBox x:Name="DebuggingViewCheckBox"
                                              Content="Debug overlay"
                                              Style="{StaticResource ToggleStyle}"
                                              Checked="PreviewSettingChanged"
                                              Unchecked="PreviewSettingChanged" />
                                    <CheckBox x:Name="ExportDebugCheckBox"
                                              Content="Export debug"
                                              Style="{StaticResource ToggleStyle}" />
                                    <CheckBox x:Name="SourceComparisonCheckBox"
                                              Content="Source guides"
                                              Style="{StaticResource ToggleStyle}"
                                              Checked="PreviewSettingChanged"
                                              Unchecked="PreviewSettingChanged" />
                                    <CheckBox x:Name="FlipXCheckBox"
                                              Content="Flip X"
                                              Style="{StaticResource ToggleStyle}"
                                              Checked="PreviewSettingChanged"
                                              Unchecked="PreviewSettingChanged" />
                                    <CheckBox x:Name="FlipYCheckBox"
                                              Content="Flip Y"
                                              Style="{StaticResource ToggleStyle}"
                                              Checked="PreviewSettingChanged"
                                              Unchecked="PreviewSettingChanged" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Background="{StaticResource CardBrush}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Assistant"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="ChatMessagesListBox"
                                         Margin="0,12,0,10"
                                         MinHeight="150"
                                         MaxHeight="240"
                                         Background="#66111A20"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource CardBorderBrush}" />
                                <TextBox x:Name="ChatInputBox"
                                         Margin="0,0,0,10"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="make this a button"
                                         KeyDown="ChatInputBox_KeyDown" />
                                <WrapPanel>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="SendChat_Click" ToolTip="Send chat">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/message-chatbot.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Send Chat" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="PreviewChatProposal_Click" ToolTip="Preview chat proposal">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/search.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Preview Proposal" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="ApplyChatProposal_Click" ToolTip="Apply chat proposal">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/shield-check.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Apply Proposal" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="RejectChatProposal_Click" ToolTip="Reject chat proposal">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/x.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Reject Proposal" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBox x:Name="AssistantPromptBox"
                                         Margin="0,12,0,10"
                                         MinHeight="58"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="make top match bottom and thinner corners" />
                                <ComboBox x:Name="PresetComboBox"
                                          Margin="0,0,0,10"
                                          SelectionChanged="PresetComboBox_SelectionChanged" />
                                <TextBox x:Name="PresetNameBox"
                                         Margin="0,0,0,10"
                                         Text="My Preset" />
                                <CheckBox x:Name="CloudAiEnabledCheckBox"
                                          Content="Cloud AI"
                                          Style="{StaticResource ToggleStyle}" />
                                <ComboBox x:Name="CloudAiProviderComboBox"
                                          Margin="0,0,0,10"
                                          SelectionChanged="CloudAiProviderComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgIcon Source="{Binding Id, Converter={StaticResource ProviderIconPathConverter}}"
                                                                  IconBrush="{StaticResource TextBrush}"
                                                                  Width="16"
                                                                  Height="16"
                                                                  Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox x:Name="CloudAiModelBox"
                                         Margin="0,0,0,10"
                                         Text="local" />
                                <TextBox x:Name="CloudAiApiKeyEnvBox"
                                         Margin="0,0,0,10"
                                         Text="OPENAI_API_KEY" />
                                <TextBox x:Name="CloudAiEndpointBox"
                                         Margin="0,0,0,10"
                                         Text="" />
                                <ComboBox x:Name="CandidateComboBox"
                                          Margin="0,0,0,10"
                                          DisplayMemberPath="Name" />
                                <WrapPanel>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="SuggestBorders_Click" ToolTip="Suggest borders from image">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/sparkles.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Suggest Borders" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="AnalyzeAssistant_Click" ToolTip="Analyze current slice">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/alert-triangle.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Analyze" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="ApplyAssistantPrompt_Click" ToolTip="Apply local prompt">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/wand.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Apply Prompt" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="AskCloudAi_Click" ToolTip="Ask cloud AI">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/brain.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Ask Cloud AI" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="OptimizeButton_Click" ToolTip="Optimize as button">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/settings.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Optimize Button" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Apply Top Recommendation" Style="{StaticResource ActionButtonStyle}" Click="ApplyTopRecommendation_Click" />
                                    <Button Content="Find Best Fit" Style="{StaticResource ActionButtonStyle}" Click="FindBestFit_Click" />
                                    <Button Content="Optimize Across Sizes" Style="{StaticResource ActionButtonStyle}" Click="OptimizeAcrossSizes_Click" />
                                    <Button Content="Preview Candidate" Style="{StaticResource ActionButtonStyle}" Click="PreviewCandidate_Click" />
                                    <Button Content="Apply Candidate" Style="{StaticResource ActionButtonStyle}" Click="ApplyCandidate_Click" />
                                    <Button Content="Save Preset" Style="{StaticResource ActionButtonStyle}" Click="SaveUserPreset_Click" />
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="BatchCheck_Click" ToolTip="Batch check">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/shield-check.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Batch Check" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="BatchExport_Click" ToolTip="Batch export">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/download.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Batch Export" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="SaveCloudAiSettings_Click" ToolTip="Save AI settings">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgIcon Source="Assets/Icons/Tabler/device-floppy.svg" IconBrush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Save AI Settings" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock x:Name="AssistantResultText"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Local assistant uses image transparency, validation, and known slice-edit commands." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Background="{StaticResource CardBrush}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Checks"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ValidationText"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Load an image to validate this slice." />
                                <TextBlock x:Name="BatchResultsText"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Batch checks will test common target sizes." />
                                <controls:SliceConceptDiagramControl Width="220"
                                                                     Height="140"
                                                                     HorizontalAlignment="Left"
                                                                     Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Background="{StaticResource CardBrush}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Vertical Borders"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Percentages are measured from the left edge of the source image." />

                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Left 1" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Vertical1Slider" Grid.Row="0" Grid.Column="1" Tag="V0" Minimum="0" Maximum="100" Value="20" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Vertical1ValueText" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="20%" />
                                    <TextBox x:Name="Vertical1TextBox" Grid.Row="0" Grid.Column="3" Tag="V0" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="20" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Left 2" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Vertical2Slider" Grid.Row="1" Grid.Column="1" Tag="V1" Minimum="0" Maximum="100" Value="40" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Vertical2ValueText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="40%" />
                                    <TextBox x:Name="Vertical2TextBox" Grid.Row="1" Grid.Column="3" Tag="V1" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="40" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Left 3" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Vertical3Slider" Grid.Row="2" Grid.Column="1" Tag="V2" Minimum="0" Maximum="100" Value="60" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Vertical3ValueText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="60%" />
                                    <TextBox x:Name="Vertical3TextBox" Grid.Row="2" Grid.Column="3" Tag="V2" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="60" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Left 4" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Vertical4Slider" Grid.Row="3" Grid.Column="1" Tag="V3" Minimum="0" Maximum="100" Value="80" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Vertical4ValueText" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="80%" />
                                    <TextBox x:Name="Vertical4TextBox" Grid.Row="3" Grid.Column="3" Tag="V3" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="80" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Background="{StaticResource CardBrush}">
                            <StackPanel>
                                <TextBlock Text="Horizontal Borders"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Percentages are measured from the top edge, matching the Unity editor window." />

                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Top 1" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Horizontal1Slider" Grid.Row="0" Grid.Column="1" Tag="H0" Minimum="0" Maximum="100" Value="20" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Horizontal1ValueText" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="20%" />
                                    <TextBox x:Name="Horizontal1TextBox" Grid.Row="0" Grid.Column="3" Tag="H0" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="20" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Top 2" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Horizontal2Slider" Grid.Row="1" Grid.Column="1" Tag="H1" Minimum="0" Maximum="100" Value="40" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Horizontal2ValueText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="40%" />
                                    <TextBox x:Name="Horizontal2TextBox" Grid.Row="1" Grid.Column="3" Tag="H1" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="40" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Top 3" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Horizontal3Slider" Grid.Row="2" Grid.Column="1" Tag="H2" Minimum="0" Maximum="100" Value="60" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Horizontal3ValueText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="60%" />
                                    <TextBox x:Name="Horizontal3TextBox" Grid.Row="2" Grid.Column="3" Tag="H2" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="60" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Top 4" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Slider x:Name="Horizontal4Slider" Grid.Row="3" Grid.Column="1" Tag="H3" Minimum="0" Maximum="100" Value="80" Foreground="{StaticResource AccentBrush}" ValueChanged="BorderSliderChanged" />
                                    <TextBlock x:Name="Horizontal4ValueText" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ValueStyle}" Text="80%" />
                                    <TextBox x:Name="Horizontal4TextBox" Grid.Row="3" Grid.Column="3" Tag="H3" Margin="8,0,0,6" LostFocus="BorderTextBoxCommitted" KeyDown="BorderTextBox_KeyDown" Text="80" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="0,18,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Background="{StaticResource PanelBrush}"
                    Margin="0,0,0,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Live Preview"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewSummaryText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14"
                                   Text="Load an image to render the 25-slice layout." />
                    </StackPanel>

                    <TextBlock x:Name="PreviewHintText"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               Text="Flip and debug toggles affect only the preview output." />
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Background="{StaticResource PanelBrush}">
                <controls:TwentyFiveSlicePreviewControl x:Name="PreviewControl" Margin="12" GuideEditChanged="PreviewControl_GuideEditChanged" />
            </Border>
        </Grid>
    </Grid>
</Window>
